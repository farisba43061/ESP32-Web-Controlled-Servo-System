#include <Arduino.h>
#include <WiFi.h>
#include <NetworkClient.h>
#include <WiFiAP.h>
#include <ESP32Servo.h>

// ---------------- PIN CONNECTIONS ----------------
const int SERVO_PIN = 22;
const int GREEN_LED_PIN = 21;
const int RED_LED_PIN = 16;

// ---------------- SERVO POSITIONS ----------------
const int OPEN_POSITION = 90;
const int CLOSE_POSITION = 0;

// ---------------- WIFI SETTINGS ----------------
const char* ssid = "ESP32-Servo";
const char* password = "12345678";

// Create server on port 80
NetworkServer server(80);

// Create servo object
Servo servoMotor;

// Stores the current servo status
String servoStatus = "CLOSED";

void setup() {
  Serial.begin(115200);

  // LED setup
  pinMode(RED_LED_PIN, OUTPUT);
  pinMode(GREEN_LED_PIN, OUTPUT);

  // Servo setup
  servoMotor.setPeriodHertz(50);
  servoMotor.attach(SERVO_PIN, 500, 2400);

  // Start in the closed position
  servoMotor.write(CLOSE_POSITION);

  // Closed: green LED ON, red LED OFF
  digitalWrite(GREEN_LED_PIN, HIGH);
  digitalWrite(RED_LED_PIN, LOW);

  Serial.println();
  Serial.println("Configuring access point...");

  // Create the ESP32 Wi-Fi network
  if (!WiFi.softAP(ssid, password)) {
    Serial.println("Soft AP creation failed.");

    while (true) {
      delay(1000);
    }
  }

  IPAddress myIP = WiFi.softAPIP();

  Serial.println("Access Point created successfully.");

  Serial.print("Wi-Fi name: ");
  Serial.println(ssid);

  Serial.print("Password: ");
  Serial.println(password);

  Serial.print("IP address: ");
  Serial.println(myIP);

  server.begin();

  Serial.println("Web server started.");
}

void loop() {
  NetworkClient client = server.accept();

  if (client) {
    Serial.println("New client connected.");

    String currentLine = "";
    String request = "";

    unsigned long startTime = millis();

    while (client.connected() && millis() - startTime < 2000) {
      if (client.available()) {
        char c = client.read();

        request += c;

        if (c == '\n') {
          if (currentLine.length() == 0) {

            // ---------------- OPEN COMMAND ----------------
            if (request.indexOf("GET /open") >= 0) {
              servoMotor.write(OPEN_POSITION);

              digitalWrite(RED_LED_PIN, HIGH);
              digitalWrite(GREEN_LED_PIN, LOW);

              servoStatus = "OPEN";

              Serial.println("Servo opened.");
            }

            // ---------------- CLOSE COMMAND ----------------
            if (request.indexOf("GET /close") >= 0) {
              servoMotor.write(CLOSE_POSITION);

              digitalWrite(RED_LED_PIN, LOW);
              digitalWrite(GREEN_LED_PIN, HIGH);

              servoStatus = "CLOSED";

              Serial.println("Servo closed.");
            }

            // ---------------- HTTP RESPONSE ----------------
            client.println("HTTP/1.1 200 OK");
            client.println("Content-Type: text/html");
            client.println("Connection: close");
            client.println();

            // ---------------- MODERN WEBPAGE ----------------
            client.println("<!DOCTYPE html>");
            client.println("<html lang='en'>");

            client.println("<head>");
            client.println("<meta charset='UTF-8'>");
            client.println(
              "<meta name='viewport' "
              "content='width=device-width, initial-scale=1.0'>"
            );

            client.println("<title>ESP32 Smart Control</title>");

            client.println("<style>");

            client.println(
              "*{"
              "box-sizing:border-box;"
              "margin:0;"
              "padding:0;"
              "}"
            );

            client.println(
              "body{"
              "min-height:100vh;"
              "display:flex;"
              "justify-content:center;"
              "align-items:center;"
              "font-family:Arial,sans-serif;"
              "background:linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);"
              "padding:20px;"
              "color:white;"
              "}"
            );

            client.println(
              ".card{"
              "width:100%;"
              "max-width:430px;"
              "background:rgba(255,255,255,0.12);"
              "border:1px solid rgba(255,255,255,0.25);"
              "border-radius:26px;"
              "padding:35px 28px;"
              "text-align:center;"
              "backdrop-filter:blur(15px);"
              "box-shadow:0 20px 45px rgba(0,0,0,0.35);"
              "}"
            );

            client.println(
              ".icon{"
              "width:75px;"
              "height:75px;"
              "display:flex;"
              "justify-content:center;"
              "align-items:center;"
              "margin:0 auto 18px;"
              "border-radius:22px;"
              "background:rgba(255,255,255,0.15);"
              "font-size:38px;"
              "}"
            );

            client.println(
              "h1{"
              "font-size:30px;"
              "margin-bottom:8px;"
              "}"
            );

            client.println(
              ".subtitle{"
              "font-size:15px;"
              "color:#dbeafe;"
              "margin-bottom:28px;"
              "}"
            );

            client.println(
              ".status-box{"
              "background:rgba(15,23,42,0.4);"
              "border-radius:18px;"
              "padding:18px;"
              "margin-bottom:25px;"
              "}"
            );

            client.println(
              ".status-label{"
              "font-size:13px;"
              "letter-spacing:2px;"
              "color:#bfdbfe;"
              "margin-bottom:8px;"
              "}"
            );

            client.println(
              ".status-value{"
              "font-size:27px;"
              "font-weight:bold;"
              "}"
            );

            // Status color
            if (servoStatus == "OPEN") {
              client.println(".status-value{color:#4ade80;}");
            } else {
              client.println(".status-value{color:#f87171;}");
            }

            client.println(
              ".buttons{"
              "display:grid;"
              "grid-template-columns:1fr 1fr;"
              "gap:14px;"
              "}"
            );

            client.println(
              "a{"
              "text-decoration:none;"
              "}"
            );

            client.println(
              "button{"
              "width:100%;"
              "padding:17px 10px;"
              "border:none;"
              "border-radius:15px;"
              "font-size:17px;"
              "font-weight:bold;"
              "color:white;"
              "cursor:pointer;"
              "transition:transform 0.2s,box-shadow 0.2s;"
              "}"
            );

            client.println(
              "button:hover{"
              "transform:translateY(-3px);"
              "}"
            );

            client.println(
              "button:active{"
              "transform:scale(0.96);"
              "}"
            );

            // OPEN button is green
            client.println(
              ".open-button{"
              "background:linear-gradient(135deg,#22c55e,#15803d);"
              "box-shadow:0 8px 20px rgba(34,197,94,0.35);"
              "}"
            );

            // CLOSE button is red
            client.println(
              ".close-button{"
              "background:linear-gradient(135deg,#ef4444,#b91c1c);"
              "box-shadow:0 8px 20px rgba(239,68,68,0.35);"
              "}"
            );

            client.println(
              ".footer{"
              "font-size:12px;"
              "color:#bfdbfe;"
              "margin-top:25px;"
              "}"
            );

            client.println(
              "@media(max-width:400px){"
              ".buttons{grid-template-columns:1fr;}"
              "h1{font-size:25px;}"
              "}"
            );

            client.println("</style>");
            client.println("</head>");

            client.println("<body>");
            client.println("<div class='card'>");

            client.println("<div class='icon'>&#9881;</div>");

            client.println("<h1>Servo Control</h1>");
            client.println(
              "<p class='subtitle'>ESP32 wireless control panel</p>"
            );

            client.println("<div class='status-box'>");
            client.println("<p class='status-label'>CURRENT STATUS</p>");

            client.print("<p class='status-value'>");
            client.print(servoStatus);
            client.println("</p>");

            client.println("</div>");

            client.println("<div class='buttons'>");

            client.println(
              "<a href='/open'>"
              "<button class='open-button'>OPEN</button>"
              "</a>"
            );

            client.println(
              "<a href='/close'>"
              "<button class='close-button'>CLOSE</button>"
              "</a>"
            );

            client.println("</div>");

            client.println(
              "<p class='footer'>ESP32 Smart Servo System</p>"
            );

            client.println("</div>");
            client.println("</body>");
            client.println("</html>");

            client.println();
            break;

          } else {
            currentLine = "";
          }

        } else if (c != '\r') {
          currentLine += c;
        }
      }
    }

    client.stop();
    Serial.println("Client disconnected.");
  }
}
